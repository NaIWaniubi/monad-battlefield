# ── 链 ──────────────────────────────────────────
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# ── 部署者 / 注资者私钥（只用于测试网，别用主钱包）──
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# ── 蜂群 ────────────────────────────────────────
BOTS=40            # 并行车道数 = 并行度上限（一个 EOA 的 tx 按 nonce 串行）
GAP_MS=500         # 每条车道间隔，500ms → 每条 2 tx/s，40 条 = 80 tx/s
FUND_MON=0.05      # 每个 bot 的初始 gas

# ── 前端 ────────────────────────────────────────
VITE_AUDIENCE_URL=   # 观众扫码入口，留空则不显示二维码
VITE_ETH_PRICE=3000
VITE_GAS_PRICE_GWEI=110
VITE_GAS_PER_TX=60000

# ── 中继服务（观众扫码代付）────────────────────
PORT=8791
# 生成多少个中继钱包。要指定私钥用 RELAYER_KEYS=0x...,0x...（这里是数量，不是私钥）
RELAYER_COUNT=8
# JOIN_URL 平时必须留空：中继会自己推导出手机能打开的局域网地址。
# 千万不要写 http://localhost:5180/join.html —— 手机永远打不开，
# 而且它会短路掉所有自动推导（中继现在会拒绝回环地址并告警）。
# 走公网隧道时由 scripts/stage.mjs 自动注入，不需要手写。
# JOIN_URL=
VITE_RELAY_URL=http://localhost:8791

# 注意：根目录 .env 的 VITE_* 不会进构建 —— vite root 是 web/，只读 web/.env。
# 想改大屏上的 gas 显示，新建 web/.env 写 VITE_GAS_PRICE_GWEI。
GAS_PRICE_GWEI=110
